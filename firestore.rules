rules_version = '2';

// ===============================================================
// Assumed Data Model & Security Architecture
// ===============================================================
//
// Collection: /test/{testId}
//   - Connection health checks (public read).
//
// Collection: /users/{userId}
//   - Document ID: Firebase Auth UID
//   - Fields: uid (string), email (string), role ('customer' | 'staff' | 'admin')
//
// Collection: /authorized_staff/{staffId}
//   - Document ID: Valid alphanumeric/hyphen/underscore identifier
//   - Fields:
//       - email: string (required, 1-254 chars)
//       - role: string (required, 'staff' | 'admin')
//   - Reads: allow get, list if isSignedIn()
//   - Writes: allow create, update, delete only if isAdmin()
//
// Collection: /clothing_items/{itemId}
//   - Garment catalogue (public read, staff/admin manage)
//
// Collection: /orders/{orderId}
//   - Customer orders (owner/staff read, authenticated customer create, staff/admin manage)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Role verification
    // 1. Bootstrapped admin email check for boutique administrator
    // 2. Or explicit 'admin' role in /users/{uid} document
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'mahibalavelusamy@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Staff verification: admin has all staff privileges, or user has 'staff' role
    function isStaff() {
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['staff', 'admin'])
      );
    }

    // Authorized staff domain validator
    function isValidAuthorizedStaff(data) {
      return data.email is string &&
        data.email.size() > 0 &&
        data.email.size() <= 254 &&
        data.role in ['staff', 'admin'];
    }

    // Health / Connection Test
    match /test/{testId} {
      allow read: if true;
    }

    // User Accounts & Roles (RBAC)
    match /users/{userId} {
      // User can view their own profile; admin can view user profiles
      allow get: if isValidId(userId) && (isSignedIn() && (request.auth.uid == userId || isAdmin()));
      allow list: if isAdmin();

      // Sign-up: customers can create their own record with role 'customer'.
      // Only bootstrapped admin can register with admin/staff role directly.
      allow create: if isValidId(userId) && isSignedIn() && request.auth.uid == userId &&
        incoming().uid == request.auth.uid &&
        incoming().email is string &&
        (
          (request.auth.token.email == 'mahibalavelusamy@gmail.com') ||
          incoming().role == 'customer'
        );

      // Updates: standard users cannot elevate their own role
      allow update: if isValidId(userId) && (
        isAdmin() ||
        (
          isSignedIn() && request.auth.uid == userId &&
          incoming().uid == existing().uid &&
          incoming().role == existing().role
        )
      );

      // Only admin can delete user records
      allow delete: if isValidId(userId) && isAdmin();
    }

    // Authorized Staff Roster
    match /authorized_staff/{staffId} {
      // Authenticated users need to check authorization during login or when viewing staff roster
      allow get: if isValidId(staffId) && isSignedIn();
      allow list: if isSignedIn();

      // Only administrators can add, edit, or remove pre-authorized staff
      allow create: if isValidId(staffId) && isAdmin() &&
        isValidAuthorizedStaff(incoming());

      allow update: if isValidId(staffId) && isAdmin() &&
        isValidAuthorizedStaff(incoming());

      allow delete: if isValidId(staffId) && isAdmin();
    }

    // Clothing Items Collection
    match /clothing_items/{itemId} {
      // Anyone (customers, visitors) can browse the garment catalogue
      allow get: if isValidId(itemId);
      allow list: if true;

      // Only authenticated staff/admin can add new items
      allow create: if isValidId(itemId) && isStaff() &&
        incoming().name is string && incoming().name.size() <= 200 &&
        incoming().price is number && incoming().price >= 0 &&
        incoming().department is string &&
        incoming().category is string &&
        incoming().inStockTotal is number && incoming().inStockTotal >= 0;

      // Only authenticated staff/admin can update stock, prices, or details
      allow update: if isValidId(itemId) && isStaff();

      // Only authenticated staff/admin can delete garments
      allow delete: if isValidId(itemId) && isStaff();
    }

    // Orders Collection
    match /orders/{orderId} {
      // Get single order receipt: only the owner or staff
      allow get: if isValidId(orderId) && (
        isStaff() || (isSignedIn() && resource.data.customerUid == request.auth.uid)
      );

      // List orders: Staff can list all orders. Authenticated customers can list only their own orders
      allow list: if isStaff() || (isSignedIn() && resource.data.customerUid == request.auth.uid);

      // Customer order placement
      allow create: if isValidId(orderId) &&
        isSignedIn() &&
        incoming().customerUid == request.auth.uid &&
        incoming().status == 'Confirmed' &&
        incoming().totalAmount is number && incoming().totalAmount >= 0 &&
        incoming().customer is map &&
        incoming().paymentStatus in ['unpaid', 'verification_pending', 'paid'];

      // Only store staff and admin can update order fulfillment status
      allow update: if isValidId(orderId) && isStaff();

      // Only store staff and admin can delete orders
      allow delete: if isValidId(orderId) && isStaff();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
