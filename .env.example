# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# RAZORPAY ONLINE PAYMENT GATEWAY
# ==============================================================================
# Generate these in Razorpay Dashboard -> Settings -> API Keys (Test mode or Live)
# Key ID is public and passed to Razorpay Checkout. Key Secret is private and used only by Express.
RAZORPAY_KEY_ID="rzp_test_YourKeyIdHere"
RAZORPAY_KEY_SECRET="YourKeySecretHere"

# Optional: Webhook Secret from Razorpay Dashboard -> Webhooks
RAZORPAY_WEBHOOK_SECRET="YourWebhookSecretHere"

# ==============================================================================
# FIREBASE ADMIN SDK SERVICE ACCOUNT
# ==============================================================================
# Option 1: Entire Service Account JSON stringified (recommended for production/containers)
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"silent-ceiling-4n50x",...}'

# Option 2: Path to downloaded service-account.json file
# FIREBASE_SERVICE_ACCOUNT_PATH="./service-account.json"

# Option 3: Individual credentials
# FIREBASE_PROJECT_ID="silent-ceiling-4n50x"
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk-...@silent-ceiling-4n50x.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
